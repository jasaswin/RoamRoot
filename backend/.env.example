# Existing variables (copied from the old project) - keep the same names
ATLASDB_URL=
SECRET=
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# New optional variables for RoamRoot
# Database name used inside your Atlas cluster (keeps RoamRoot data separate from your old data)
DB_NAME=roamroot
PORT=8080
CLIENT_URL=http://localhost:5173
NODE_ENV=development
# Optional: enables AI-written text in the planner/assistant (the app works without it)
ANTHROPIC_API_KEY=
AI_MODEL=
